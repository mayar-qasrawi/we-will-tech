  <header class="site-shell-header">
    <div class="shell-inner">
      <a class="shell-brand" href="/">
        <img
          class="shell-brand-logo "
          src="/uploads/7f2b7b2a3047ff5ea3ec0fcf.jpg"
          alt="WE WILL"
          data-site-setting-src="brand_logo"
          data-site-setting-alt="brand_name"
        >
        <span class="shell-brand-text" data-site-setting="brand_name">WE WILL</span>
      </a>
      <nav id="shell-nav" class="shell-nav" aria-label="Main">
        <a
          href="{{ navHomeHref }}"
          class="{% if activeNav == 'home' %}is-active{% endif %}"
          {% if activeNav == 'home' %}aria-current="page"{% endif %}
          data-site-setting="header_nav_hero"
        >Home</a>
        <a
          href="/vibe-test/"
          class="{% if activeNav == 'vibe-test' %}is-active{% endif %}"
          {% if activeNav == 'vibe-test' %}aria-current="page"{% endif %}
          data-site-setting="header_nav_vibe_test"
        >Vibe Test</a>
        <a
          href="/solutions/"
          class="{% if activeNav == 'solutions' %}is-active{% endif %}"
          {% if activeNav == 'solutions' %}aria-current="page"{% endif %}
          data-site-setting="header_nav_solutions"
        >Solutions</a>
        <a
          href="/resources/"
          class="{% if activeNav == 'resources' %}is-active{% endif %}"
          {% if activeNav == 'resources' %}aria-current="page"{% endif %}
          data-site-setting="header_nav_resources"
        >Resources</a>
        <a
          href="/about/"
          class="{% if activeNav == 'about' %}is-active{% endif %}"
          {% if activeNav == 'about' %}aria-current="page"{% endif %}
          data-site-setting="header_nav_about"
        >About</a>
        <a
          href="/contact/?request=guided-vibe-test"
          class="btn btn-primary shell-nav-cta"
          data-site-setting="header_nav_cta"
        >Run a Guided Vibe Test</a>
      </nav>
      <div class="shell-header-actions">
        <div class="lang-switcher shell-lang-switcher" aria-label="Language switcher">
          <button type="button" class="lang-btn is-active" data-lang="en">EN</button>
          <button type="button" class="lang-btn" data-lang="ar">AR</button>
        </div>
        <button type="button" class="shell-nav-toggle" aria-expanded="false" aria-controls="shell-nav">Menu</button>
      </div>
      <div class="shell-nav-backdrop"></div>
    </div>
  </header>
