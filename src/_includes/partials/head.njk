  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script>document.documentElement.classList.add('js-anim');</script>
  <title>{{ title | safe }}</title>
  <meta name="description" content="{{ description | safe }}" />
  <link rel="canonical" href="{{ canonical | safe }}" />
  <meta property="og:type" content="{{ ogType | safe }}" />
  <meta property="og:site_name" content="WE WILL Technology" />
  <meta property="og:title" content="{{ ogTitle | safe }}" />
  <meta property="og:description" content="{{ ogDescription | safe }}" />
  <meta property="og:url" content="{{ ogUrl | safe }}" />
  <meta property="og:image" content="{{ ogImage | safe }}" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="ar_SA" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ twitterTitle | safe }}" />
  <meta name="twitter:description" content="{{ twitterDescription | safe }}" />
  <meta name="twitter:image" content="{{ twitterImage | safe }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="stylesheet" href="/assets/layout.css">
{% if extraCss %}  <link rel="stylesheet" href="{{ extraCss }}">
{% endif %}{% if reviewAssets %}  <link rel="stylesheet" href="/assets/variants/hero-variants.css">
  <link rel="stylesheet" href="/assets/variants/variant-switcher.css">
  <script src="/assets/variants/variant-switcher.js" defer></script>
{% endif %}{% if jsonLd %}  <script type="application/ld+json">{{ jsonLd | dump | safe }}</script>
{% endif %}{% if noindex %}  <meta name="robots" content="noindex" />
{% endif %}
